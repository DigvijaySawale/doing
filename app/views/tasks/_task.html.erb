<div id="<%= dom_id task %>">
  <div>
    <strong>Title:</strong>
    <%= task.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= task.description %>
  </div>

  <div>
    <strong>Scheduled date:</strong>
    <%= task.scheduled_date %>
  </div>

  <div>
    <strong>Due date:</strong>
    <%= task.due_date %>
  </div>

  <div>
    <strong>Has time:</strong>
    <%= task.has_time %>
  </div>

  <div>
    <strong>Start time:</strong>
    <%= task.start_time %>
  </div>

  <div>
    <strong>End time:</strong>
    <%= task.end_time %>
  </div>

  <div>
    <strong>Duration minutes:</strong>
    <%= task.duration_minutes %>
  </div>

  <div>
    <strong>Priority:</strong>
    <%= task.priority %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= task.status %>
  </div>

  <div>
    <strong>Completed at:</strong>
    <%= task.completed_at %>
  </div>

  <div>
    <strong>Is recurring:</strong>
    <%= task.is_recurring %>
  </div>

</div>
