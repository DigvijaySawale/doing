<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
      <div class="card shadow rounded-3">
        <div class="card-header bg-white">
          <h5 class="mb-0"><%= task.title %></h5>
        </div>

        <div class="card-body">
          <div id="<%= dom_id task %>">

            <div class="mb-3">
              <h6 class="text-muted">Description</h6>
              <p class="mb-0">
                <%= task.description.presence || "-" %>
              </p>
            </div>

            <hr>

            <div class="row mb-3">
              <div class="col-sm-6">
                <strong>Scheduled Date</strong><br>
                <%= friendly_date(task.scheduled_date) %>
              </div>

              <div class="col-sm-6">
                <strong>Due Date</strong><br>
                <%= friendly_date(task.due_date) %>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-sm-6">
                <strong>Start Time</strong><br>
                <%= task.start_time&.strftime("%I:%M %p") || "-" %>
              </div>

              <div class="col-sm-6">
                <strong>End Time</strong><br>
                <%= task.end_time&.strftime("%I:%M %p") || "-" %>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-sm-6">
                <strong>Duration</strong><br>
                <%= task.duration_minutes.present? ? "#{task.duration_minutes} mins" : "-" %>
              </div>

              <div class="col-sm-6">
                <strong>Completed At</strong><br>
                <%= task.completed_at&.strftime("%d %b %Y, %I:%M %p") || "-" %>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-sm-6">
                <strong>Priority</strong><br>
                <span class="badge priority-<%= task.priority.dasherize %>">
                  <%= task.priority.humanize %>
                </span>
              </div>

              <div class="col-sm-6">
                <strong>Status</strong><br>
                <span class="badge status-<%= task.status.dasherize %>">
                  <%= task.status.humanize %>
                </span>
              </div>
            </div>

            <div class="row">
              <div class="col-sm-6">
                <strong>Has Time</strong><br>
                <% if task.has_time? %>
                  <span class="badge bg-success">Yes</span>
                <% else %>
                  <span class="badge bg-secondary">No</span>
                <% end %>
              </div>

              <div class="col-sm-6">
                <strong>Recurring</strong><br>
                <% if task.is_recurring? %>
                  <span class="badge bg-success">Yes</span>
                <% else %>
                  <span class="badge bg-secondary">No</span>
                <% end %>
              </div>
            </div>

          </div>
        </div>

        <div class="card-footer bg-white d-flex justify-content-end gap-2">
          <%= link_to "Back", tasks_path, class: "btn btn-outline-secondary" %>
          <%= link_to "Edit", edit_task_path(task), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>