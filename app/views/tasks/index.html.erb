<p style="color: green"><%= notice %></p>

<% content_for :title, "Tasks" %>

<h1>Tasks</h1>

<div id="tasks">
    <table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Title</th>
      <th scope="col">Scheduled Date</th>
      <th scope="col">Due date</th>
      <th scope="col">Priority</th>
      <th scope="col">Status</th>
    </tr>
  </thead>
  <tbody>
    
      <% @tasks.each do |task| %>
        <tr>
          <th scope="row">1</th>
          <td><%= task.title %></td>
          <td><%= task.scheduled_date %></td>
          <td><%= task.due_date %></td>
          <td><%= task.priority %></td>
          <td><%= task.status %></td>
          <td><%= link_to "Show this task", task %></td>
        </tr>
      <% end %>
    
  </tbody>
</table>
  
</div>

<%= link_to "New task", new_task_path %>
