<div class="container">
  <% if notice.present? %>
    <p class="alert alert-success" role="alert"><%= notice %></p>
  <% end %> 

  <% content_for :title, "Today's Tasks" %>

  <h1>Today's Tasks</h1>

  <%= render "shared/summary_cards", cards: [
    { title: "Today's Tasks", count: @tasks.count, class: "primary" },
    { title: "Completed", count: @completed_tasks.count, class: "success" },
    { title: "Pending", count: @pending_tasks.count, class: "warning" },
    { title: "Overdue", count: @overdue_tasks.count, class: "danger" }
  ] %>

  <%= render "shared/tasks_list", tasks: @tasks %>
    
</div>