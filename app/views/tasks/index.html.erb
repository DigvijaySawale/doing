<div class="container">
  <p style="color: green"><%= notice %></p>

  <% content_for :title, "Tasks" %>

  <h1>Tasks</h1>

  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card text-bg-primary shadow-sm">
        <div class="card-body text-center">
          <h6 class="card-title">Today's Tasks</h6>
          <h2><%= @tasks.count %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-bg-success shadow-sm">
        <div class="card-body text-center">
          <h6 class="card-title">Completed</h6>
          <h2><%= @completed_tasks.count %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-bg-warning shadow-sm">
        <div class="card-body text-center">
          <h6 class="card-title">Pending</h6>
          <h2><%= @pending_tasks.count %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-bg-danger shadow-sm">
        <div class="card-body text-center">
          <h6 class="card-title">Overdue</h6>
          <h2><%= @overdue_tasks.count %></h2>
        </div>
      </div>
    </div>
  </div>

  <div id="tasks">
    <% if @tasks.any? %>
      
      <table class="table table-striped">
        <thead>
          <tr>
            <th scope="col">Title</th>
            <th scope="col">Scheduled Date</th>
            <th scope="col">Due date</th>
            <th scope="col">Priority</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <td><%= task.title %></td>
              <td><%= task.scheduled_date.strftime("%d %b") %></td>
              <td><%= task.due_date&.strftime("%d %b") %></td>
              <td><%= task.priority %></td>
              <td><%= task.status %></td>
              <td ><%= link_to "Show", task %> |<%= link_to "Edit", edit_task_path(task) %> | <%= link_to "Destroy", task,
                  class: "text-danger",
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    
    <% else %>
      <h5>🎉 No tasks scheduled for today.</h5>
      <h5>Create your first task to get started.</h5>
    <% end %>
  </div>
</div>